<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.ccl.cclautoclick.controller.AutoClickController"
      style="-fx-background-color: linear-gradient(to bottom, #fafafa, #f0f0f0);">

    <padding>
        <Insets top="15.0" right="15.0" bottom="15.0" left="15.0"/>
    </padding>

    <!-- 标题区 -->
    <VBox alignment="CENTER" spacing="3.0" style="-fx-padding: 0 0 10 0;">
        <Label text="🎯 CclAutoClick"
               style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
        <Label text="智能连点器 - Smart Auto Clicker"
               style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
    </VBox>

    <!-- 主内容区：左右结构 -->
    <HBox spacing="15.0" VBox.vgrow="ALWAYS">

        <!-- 左侧：配置区域 -->
        <VBox spacing="10.0" HBox.hgrow="ALWAYS">

            <!-- 触发模式选择区 -->
            <TitledPane text="⚙️ 触发设置" style="-fx-font-weight: bold; -fx-font-size: 12px;">
                <VBox spacing="8.0">
                    <padding>
                        <Insets top="8.0" right="8.0" bottom="8.0" left="8.0"/>
                    </padding>

                    <!-- 触发模式单选按钮 -->
                    <VBox spacing="5.0">
                        <Label text="触发模式:"
                               style="-fx-font-size: 11px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                        <HBox spacing="10.0" alignment="CENTER_LEFT">
                            <RadioButton fx:id="holdModeRadio" text="按住激活 (HOLD)"
                                         style="-fx-font-size: 12px;"/>
                            <RadioButton fx:id="toggleModeRadio" text="单击切换 (TOGGLE)"
                                         style="-fx-font-size: 12px;"/>
                        </HBox>
                    </VBox>
                </VBox>
            </TitledPane>

            <!-- 按键配置表格区 -->
            <TitledPane text="📋 按键配置" VBox.vgrow="ALWAYS" style="-fx-font-weight: bold; -fx-font-size: 12px;">
                <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                    <padding>
                        <Insets top="8.0" right="8.0" bottom="8.0" left="8.0"/>
                    </padding>

                    <!-- 提示标签 -->
                    <Label text="💡 点击'重新捕获'可更改按键"
                           style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;"/>

                    <!-- 配置表格 -->
                    <TableView fx:id="configTable" prefHeight="280.0" VBox.vgrow="ALWAYS"
                               style="-fx-font-size: 11px;">
                        <columns>
                            <TableColumn fx:id="enabledColumn" text="启用" prefWidth="50.0"/>
                            <TableColumn fx:id="keyColumn" text="按键" prefWidth="120.0"/>
                            <TableColumn fx:id="intervalColumn" text="间隔(ms)" prefWidth="85.0"/>
                            <TableColumn fx:id="delayColumn" text="延迟(ms)" prefWidth="85.0"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                    </TableView>

                    <!-- 表格操作按钮 -->
                    <HBox spacing="6.0" alignment="CENTER_RIGHT">
                        <Button text="➕ 添加" onAction="#onAddRowClicked"
                                style="-fx-background-color: #27ae60; -fx-text-fill: white; -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 4 10 4 10;"/>
                        <Button text="➖ 删除" onAction="#onDeleteRowClicked"
                                style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 4 10 4 10;"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button text="💾 保存" onAction="#onSaveConfigClicked"
                                style="-fx-background-color: #3498db; -fx-text-fill: white; -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 4 10 4 10;"/>
                        <Button text="📂 加载" onAction="#onLoadConfigClicked"
                                style="-fx-background-color: #f39c12; -fx-text-fill: white; -fx-font-size: 11px; -fx-cursor: hand; -fx-padding: 4 10 4 10;"/>
                    </HBox>
                </VBox>
            </TitledPane>
        </VBox>

        <!-- 右侧：控制面板 -->
        <VBox spacing="10.0" prefWidth="180.0" minWidth="160.0">

            <!-- 控制按钮区 -->
            <TitledPane text="🎮 控制面板" style="-fx-font-weight: bold; -fx-font-size: 12px;">
                <VBox spacing="12.0" alignment="CENTER">
                    <padding>
                        <Insets top="15.0" right="10.0" bottom="15.0" left="10.0"/>
                    </padding>

                    <Button fx:id="startButton" text="▶ 启动" onAction="#onStartClicked"
                            style="-fx-background-color: #2ecc71; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-pref-width: 140px; -fx-pref-height: 45px; -fx-cursor: hand;"/>

                    <Button fx:id="stopButton" text="⏹ 停止" onAction="#onStopClicked" disable="true"
                            style="-fx-background-color: #e74c3c; -fx-text-fill: white; -fx-font-size: 14px; -fx-font-weight: bold; -fx-pref-width: 140px; -fx-pref-height: 45px; -fx-cursor: hand;"/>

                    <Separator/>

                    <!-- 全局快捷键设置 -->
                    <VBox spacing="6.0" alignment="CENTER">
                        <Label text="全局启停快捷键:"
                               style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                        <HBox spacing="6.0" alignment="CENTER">
                            <Button fx:id="captureHotkeyButton" text="点击设置" onAction="#onCaptureHotkeyClicked"
                                    style="-fx-font-size: 10px; -fx-pref-width: 80px; -fx-cursor: hand;"/>
                            <Button text="清除" onAction="#onClearHotkeyClicked"
                                    style="-fx-font-size: 10px; -fx-pref-width: 50px; -fx-cursor: hand;"/>
                        </HBox>
                    </VBox>
                </VBox>
            </TitledPane>

            <!-- 状态显示区 -->
            <TitledPane text="📊 运行状态" style="-fx-font-weight: bold; -fx-font-size: 12px;">
                <VBox spacing="8.0">
                    <padding>
                        <Insets top="10.0" right="10.0" bottom="10.0" left="10.0"/>
                    </padding>

                    <Label fx:id="statusLabel" text="✅ 就绪" wrapText="true"
                           style="-fx-font-size: 11px; -fx-text-fill: #2c3e50; -fx-font-weight: bold;"/>

                    <Separator/>

                    <VBox spacing="5.0">
                        <Label text="使用说明:"
                               style="-fx-font-size: 10px; -fx-font-weight: bold; -fx-text-fill: #34495e;"/>
                        <Label text="• 按住激活: 按住按键开始连点"
                               style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;" wrapText="true"/>
                        <Label text="• 单击切换: 按一次开始/停止"
                               style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;" wrapText="true"/>
                        <Label text="• 全局快捷键: 随时启停程序"
                               style="-fx-font-size: 10px; -fx-text-fill: #7f8c8d;" wrapText="true"/>
                    </VBox>
                </VBox>
            </TitledPane>
        </VBox>
    </HBox>

</VBox>
